# Copy to /etc/dial-in-trigger.env; keep credentials out of Git.
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+12025550100
TWILIO_PHONE_NUMBER_SID=PN00000000000000000000000000000000
PUBLIC_BASE_URL=https://dial.example.com
# Use a private random sequence of 8–32 digits or *. Press # to submit it.
TRIGGER_CODE=REPLACE_ME
# Optional comma-separated E.164 callers. Caller ID is only an extra filter.
ALLOWED_CALLERS=
VOICE_PROMPT="Enter your access code, followed by pound."
# Optional WAV/MP3 file mounted into the web container; replaces the spoken prompt.
GREETING_FILE=
# true: the first key interrupts playback; false: play the whole recording first.
GREETING_INTERRUPTIBLE=true
# Maximum pause between digits; Twilio submits collected digits when this expires.
DIGIT_TIMEOUT_SECONDS=10
DIAL_IN_STATE_DIR=/data
TRIGGER_SCRIPT=/scripts/trigger.sh
SCRIPT_TIMEOUT_SECONDS=60
